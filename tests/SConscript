import os
import sys
import platform

BIN_DIR=os.environ['BIN_DIR'];
TK_ROOT=os.environ['TK_ROOT'];
TK_3RD_ROOT=os.environ['TK_3RD_ROOT'];
GTEST_ROOT=os.environ['GTEST_ROOT'];
APP_SRC=os.environ['APP_SRC'];

env=DefaultEnvironment().Clone();

INCLUDE_PATH = [TK_ROOT, 
  GTEST_ROOT,
  APP_SRC,
  os.path.join(TK_ROOT, 'src'),  
  os.path.join(TK_3RD_ROOT, 'SDL/src'), 
  os.path.join(TK_3RD_ROOT, 'SDL/include'), 
  os.path.join(TK_ROOT, 'src/ext_widgets'),  
  os.path.join(TK_ROOT, '3rd/libunibreak'),
  os.path.join(GTEST_ROOT, 'src'),
  os.path.join(GTEST_ROOT, 'include'),
  os.path.join(GTEST_ROOT, 'make')] 

env['CPPPATH'] = env['CPPPATH'] + INCLUDE_PATH
# Old bundled gtest still references std::tr1; disable it under C++11+.
env.Append(CPPDEFINES=['GTEST_HAS_TR1_TUPLE=0', 'GTEST_LANG_CXX11=1'])

SOURCES = [
 os.path.join(GTEST_ROOT, 'src/gtest-all.cc'),
] + Glob('*.cc') + Glob('*.c')

# Shared coin3d.dll only exports the C API from coin3d.def. Unit tests also call
# internal C++ helpers (Coin3dView / gizmo math), so compile those units into a
# separate object dir (avoid clashing with src/SConscript outputs) and link them.
if platform.system() == 'Windows':
  test_env = env.Clone()
  obj_dir = os.path.join('tests_objs')
  if not os.path.exists(obj_dir):
    os.makedirs(obj_dir)
  extra_srcs = []
  extra_srcs += Glob(os.path.join(APP_SRC, 'coin3d', '*.cpp'))
  extra_srcs += Glob(os.path.join(APP_SRC, '*.c'))
  test_env.Append(CPPDEFINES=['GLAD_GLAPI_EXPORT'])
  extra_objs = []
  for src in extra_srcs:
    src_path = str(src)
    base = os.path.splitext(os.path.basename(src_path))[0]
    target = os.path.join(obj_dir, base + test_env['OBJSUFFIX'])
    extra_objs.append(test_env.Object(target=target, source=src_path))
  SOURCES += extra_objs
  env = test_env
  env['LIBS'] = [lib for lib in env['LIBS'] if lib != 'coin3d']

env.Program(os.path.join(BIN_DIR, 'runTest'), SOURCES);
